# 환경 변수 템플릿
# 이 파일을 복사해서 .env.local을 만들고 실제 값을 입력하세요
# .env.local 파일은 절대 Git에 올리지 마세요

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Claude API (AI 상담)
ANTHROPIC_API_KEY=

# 카카오톡 채널 API
KAKAO_CHANNEL_ID=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# 토스페이먼츠 (결제)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 080 전화 (AI 음성 — 2차 개발)
# RETELL_API_KEY=
